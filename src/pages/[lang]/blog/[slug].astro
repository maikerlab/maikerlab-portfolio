---
import { CollectionEntry, getCollection } from "astro:content";
import { BlogSchema } from "src/content/config";
import PostLayout from "src/layouts/PostLayout.astro";
import createSlug from "src/lib/createSlug";

export async function getStaticPaths() {
  const pages = await getCollection("blog");
  const paths = pages.map((entry) => {
    const [lang, ...slug] = entry.id.split("/");
    return {
      params: {
        lang,
        slug: createSlug(entry.data.title, entry.slug),
      },
      props: { entry },
    };
  });
  return paths;
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const post: BlogSchema = entry.data;
const { Content } = await entry.render();
---

<PostLayout
  title={post.title}
  description={post.description}
  pubDate={post.pubDate}
  heroImage={post.heroImage}
  updatedDate={post.updatedDate}
  badge={post.badge}
  tags={post.tags}
>
  <Content />
</PostLayout>
