---
import BaseLayout from "src/layouts/BaseLayout.astro";
import TimeLineElement from "src/components/cv/TimeLine.astro";
import { getLangFromUrl, useTranslations } from "src/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type Course = {
  name: string;
  link?: string;
};
const courses: Course[] = [
  {
    name: "Claude Code in Action",
    link: "https://verify.skilljar.com/c/4mt7wtp8msrb",
  },
  {
    name: "Advanced Rust Programming",
    link: "https://www.coursera.org/account/accomplishments/records/4WRTIYNBBKVG",
  },
  {
    name: "Linux System Programming and Introduction to Buildroot",
    link: "https://www.coursera.org/account/accomplishments/verify/IMJKOU7V0BUN",
  },
  {
    name: "nRF Connect SDK Intermediate",
    link: "https://academy.nordicsemi.com/check-certificate/7019A88A14C69C2-7019A88A10E4CF7-11EFA0108D2EAD_33/",
  },
  {
    name: "nRF Connect SDK Fundamentals",
    link: "https://academy.nordicsemi.com/check-certificate/7019A8682A814E3-7019A8677274C08-11EFA0108D2EAD_33/",
  },
  {
    name: "Advanced Golang",
    link: "https://learn.kodekloud.com/certificate/eb5e422c-69c6-4e20-a2fa-52d3fa5ab741",
  },
  {
    name: "Bitcoin Development Mentorship Programme at Des Femmes Magazine",
    link: "https://gist.github.com/maikerlab/e6886d54c97d912aae44a50e65c2473e",
  },
  {
    name: "GitLab CI/CD: Architecting, Deploying, and Optimizing Pipelines",
    link: "https://learn.kodekloud.com/certificate/ca337a0a-636a-4d55-8368-9025b746964c",
  },
];

type Skill = {
  name: string;
  proficiency: number;
};

const skills: Skill[] = [
  {
    name: "Rust",
    proficiency: 4,
  },
  {
    name: "C",
    proficiency: 5,
  },
  {
    name: "Java",
    proficiency: 5,
  },
  {
    name: "Kotlin",
    proficiency: 4,
  },
  {
    name: "Go",
    proficiency: 3,
  },
  {
    name: "Docker",
    proficiency: 4,
  },
].sort((a, b) => b.proficiency - a.proficiency);

export function getStaticPaths() {
  return [{ params: { lang: "de" } }, { params: { lang: "en" } }];
}
---

<BaseLayout title={t("pages.cv")} sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">{t("cv.title")}</div>
  </div>

  <div class="mb-10 text-justify">
    {t("cv.intro")}
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">{t("cv.experience")}</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement title={t("cv.twk.title")} subtitle={t("cv.twk.subtitle")}>
      {t("cv.twk.description")}
    </TimeLineElement>
    <TimeLineElement
      title={t("cv.akra_professional.title")}
      subtitle={t("cv.akra_professional.subtitle")}
    >
      {t("cv.akra_professional.description")}
    </TimeLineElement>
    <TimeLineElement
      title={t("cv.akra_working_student.title")}
      subtitle={t("cv.akra_working_student.subtitle")}
    >
      {t("cv.akra_working_student.description")}
    </TimeLineElement>
    <TimeLineElement
      title={t("cv.sick_working_student.title")}
      subtitle={t("cv.sick_working_student.subtitle")}
    >
      {t("cv.sick_working_student.description")}
    </TimeLineElement>
    <TimeLineElement
      title={t("cv.sick_rpe.title")}
      subtitle={t("cv.sick_rpe.subtitle")}
    >
      {t("cv.sick_rpe.description")}
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">{t("cv.education")}</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title={t("cv.study.title")}
      subtitle={t("cv.study.description")}
    />
    <TimeLineElement
      title={t("cv.technician.title")}
      subtitle={t("cv.technician.description")}
    />
    <TimeLineElement
      title={t("cv.apprenticeship.title")}
      subtitle={t("cv.apprenticeship.description")}
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">{t("cv.certifications")}</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    {
      courses.map((course) => (
        <li>
          <a
            class="underline hover:bg-base-200"
            href={course.link}
            target="_blank"
          >
            {course.name}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">{t("cv.skills")}</div>
  </div>

  <ul class="list-none md:columns-5 columns-2 mx-6">
    {
      skills.map((skill) => (
        <li>
          {"⭐️".repeat(skill.proficiency)} {skill.name}
        </li>
      ))
    }
  </ul>
</BaseLayout>
