---
import BaseLayout from "src/layouts/BaseLayout.astro";
import HorizontalCard from "src/components/HorizontalCard.astro";
import { getLangFromUrl, useTranslations } from "src/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export function getStaticPaths() {
  return [{ params: { lang: "de" } }, { params: { lang: "en" } }];
}
---

<BaseLayout title={t("pages.services")} sideBarActiveItemID="services">
  <div>
    <div class="text-3xl w-full font-bold mb-5">{t("services.title")}</div>
  </div>

  <HorizontalCard
    title={t("services.smart_home.title")}
    desc={t("services.smart_home.description")}
    url="#"
  />
  <HorizontalCard
    title={t("services.devops.title")}
    desc={t("services.devops.description")}
    url="#"
  />
  <HorizontalCard
    title={t("services.backend_development.title")}
    desc={t("services.backend_development.description")}
    url="#"
  />
  <HorizontalCard
    title={t("services.embedded_systems.title")}
    desc={t("services.embedded_systems.description")}
    url="#"
  />
  <HorizontalCard
    title={t("services.embedded_linux.title")}
    desc={t("services.embedded_linux.description")}
    url="#"
  />
</BaseLayout>
