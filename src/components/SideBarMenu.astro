---
import { getLangFromUrl, useTranslations } from "src/i18n/utils";

const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300"; // For primary color replace with `active` class

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ul class="menu grow shrink menu-md overflow-y-auto">
    <li>
        <a class="py-3 text-base" id="home" href={`/${lang}/`}
            >{t("nav.home")}</a
        >
    </li>
    <li>
        <a class="py-3 text-base" id="projects" href={`/${lang}/projects`}
            >{t("nav.projects")}</a
        >
    </li>
    <li>
        <a class="py-3 text-base" id="services" href={`/${lang}/services`}
            >{t("nav.services")}</a
        >
    </li>
    <li>
        <a class="py-3 text-base" id="blog" href={`/${lang}/blog/`}
            >{t("nav.blog")}</a
        >
    </li>
    <li>
        <a class="py-3 text-base" id="cv" href={`/${lang}/cv`}>{t("nav.cv")}</a>
    </li>
</ul>

<script
    define:vars={{
        sideBarActiveItemID: sideBarActiveItemID,
        activeClass: activeClass,
    }}
>
    const activeItemElem = document.getElementById(sideBarActiveItemID);
    activeItemElem && activeItemElem.classList.add(activeClass);
</script>
