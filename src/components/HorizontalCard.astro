---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<div
  class="group rounded-lg border border-base-300 bg-base-100 text-base-content my-2 transition-colors duration-200 ease-in-out hover:bg-base-content hover:text-base-100"
>
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row">
      {
        img && (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {title}
          {badge && (
            <div
              class="badge badge-secondary mx-2 border-transparent group-hover:bg-primary group-hover:text-primary-content"
            >
              {badge}
            </div>
          )}
        </h1>
        <p class="py-1 text-1xl opacity-90 group-hover:opacity-80">{desc}</p>
        <div class="card-actions justify-end">
          {
            tags &&
              tags.map((tag) => (
                <a
                  href={`${tag_url}/${tag}`}
                  class="badge badge-outline group-hover:border-base-100/40 group-hover:text-base-100"
                >
                  {tag}
                </a>
              ))
          }
        </div>
      </div>
    </div>
  </a>
</div>
