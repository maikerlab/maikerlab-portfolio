---
import { languages } from "src/i18n/ui";
import { getLangFromUrl } from "src/i18n/utils";

const currentLang = getLangFromUrl(Astro.url);

const changeCurrentUrl = (lang: string) => {
    const currentUrl = new URL(Astro.url);
    currentUrl.pathname = currentUrl.pathname.replace(
        /^\/[a-z]{2}\//,
        `/${lang}/`,
    );
    return currentUrl.pathname + currentUrl.search + currentUrl.hash;
};
---

<div class="flex shrink-0 items-center">
    <div
        class="join overflow-hidden rounded-btn border border-base-300"
        role="navigation"
        aria-label="Language"
    >
        {
            Object.entries(languages).map(([lang, label]) => {
                const isCurrent = lang === currentLang;
                return (
                    <a
                        href={changeCurrentUrl(lang)}
                        class:list={[
                            "btn btn-sm join-item min-w-[2.75rem] font-medium",
                            isCurrent
                                ? "btn-primary"
                                : "btn-ghost text-base-content/80",
                        ]}
                        aria-label={label.name}
                        title={label.name}
                        aria-current={isCurrent ? "page" : undefined}
                    >
                        {lang.toUpperCase()}
                    </a>
                );
            })
        }
    </div>
</div>
