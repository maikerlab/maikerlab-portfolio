---
import { getLangFromUrl, useTranslations } from "src/i18n/utils";
import { THEME_DARK, THEME_LIGHT, THEME_STORAGE_KEY } from "src/config";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="flex shrink-0 items-center">
    <label
        class="flex cursor-pointer items-center gap-2"
        title={t("theme.toggle")}
    >
        <svg
            class="h-5 w-5 text-base-content/70"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
            ></path>
        </svg>
        <input
            type="checkbox"
            id="theme-toggle"
            class="toggle toggle-primary !rounded-full before:!rounded-full"
            aria-label={t("theme.toggle")}
        />
        <svg
            class="h-5 w-5 text-base-content/70"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
            ></path>
        </svg>
    </label>
</div>

<script
    define:vars={{
        THEME_LIGHT,
        THEME_DARK,
        THEME_STORAGE_KEY,
    }}
>
    function setTheme(theme) {
        document.documentElement.setAttribute("data-theme", theme);
        localStorage.setItem(THEME_STORAGE_KEY, theme);
        syncToggle(theme);
    }

    function syncToggle(theme) {
        const isDark = theme === THEME_DARK;
        document.querySelectorAll("#theme-toggle").forEach((input) => {
            input.checked = isDark;
        });
    }

    function onToggleChange(event) {
        const input = event.target;
        if (!(input instanceof HTMLInputElement) || input.id !== "theme-toggle") {
            return;
        }
        setTheme(input.checked ? THEME_DARK : THEME_LIGHT);
    }

    function initThemeToggle() {
        const stored = localStorage.getItem(THEME_STORAGE_KEY);
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme =
            stored === THEME_LIGHT || stored === THEME_DARK
                ? stored
                : prefersDark
                    ? THEME_DARK
                    : THEME_LIGHT;
        document.documentElement.setAttribute("data-theme", theme);
        syncToggle(theme);
        document.removeEventListener("change", onToggleChange);
        document.addEventListener("change", onToggleChange);
    }

    initThemeToggle();
    document.addEventListener("astro:after-swap", initThemeToggle);
</script>
